# CorvenTech — cPanel (Apache / LiteSpeed) ayarları
# Bu dosya "npm run build" ile dist/ içine kopyalanır; public_html'e onunla birlikte yüklenir.
# Her blok IfModule ile korunuyor: ilgili modül sunucuda yoksa kural yok sayılır, site 500 vermez.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https (SSL sertifikası cPanel'de aktif edildikten SONRA etkili olur)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # corventech.tr -> www.corventech.tr (tek kanonik adres)
  RewriteCond %{HTTP_HOST} ^corventech\.tr$ [NC]
  RewriteRule ^(.*)$ https://www.corventech.tr/$1 [R=301,L]
</IfModule>

# Olmayan adresler sitenin kendi sayfasını göstersin (tek sayfa uygulama)
ErrorDocument 404 /index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hash'li dosya adları (index-XXXX.js/css) değiştiğinde adı da değişir: uzun önbellek güvenli
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresDefault "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # index.html her zaman taze gelsin ki yeni sürüm anında görünsün
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Dizin listelemesini kapat
Options -Indexes
